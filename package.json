{
  "name": "wrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copy:worklets": "node scripts/copy-worklets.mjs",
    "dev": "pnpm copy:worklets && (node scripts/copy-worklets.mjs --watch & NEXT_TELEMETRY_DISABLED=1 next dev)",
    "build": "pnpm copy:worklets && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "test:dsp": "node --test \"tests/dsp/**/*.test.js\"",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.57.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "globals": "17.13.0"
  }
}
